PORT=5000
FLASK_DEBUG=1
# Browser origins allowed to call the API. Unset means localhost/127.0.0.1 on
# any port, which covers the Vite dev server. In production the SPA and the API
# share one origin, so this can stay unset there too. "*" allows any origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Ceiling on an HTTP request body, i.e. the web form's peptide and custom
# database uploads. The CLI reads from disk and ignores this.
# MAX_UPLOAD_MB=32
# Unset means a random key per worker. Set it if anything starts signing sessions.
# SECRET_KEY=
# BIO_DATABASE_DIR=/absolute/path/to/bio-database
# JOB_DB=/absolute/path/to/crossdome_jobs.sqlite3
# OUTPUT_DIR=/absolute/path/to/outputs
# UPLOAD_DIR=/absolute/path/to/uploads
